# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Vector Store (Qdrant)
VECTOR_HOST=localhost
VECTOR_PORT=6333
VECTOR_API_KEY=
VECTOR_COLLECTION=news_chunks

# Kafka (local dev only)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEWS=raw_news_topic

# AWS / Bedrock
BEDROCK_ENABLED=true
BEDROCK_REGION=ap-southeast-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSION=1024

# LLM Providers (support multiple)
LLM_COUNT=1
LLM_1_NAME=default
LLM_1_PROVIDER=groq
LLM_1_MODEL_ID=qwen/qwen3-8b-instant
LLM_1_API_KEY=
LLM_1_TEMPERATURE=0.3
LLM_1_MAX_TOKENS=2048

# Retrieval
TOP_K=20
SIMILARITY_THRESHOLD=0.75
ENABLE_RERANKER=false