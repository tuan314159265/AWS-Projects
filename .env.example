# --- POSTGRESQL (Auto-filled by Terraform on AWS) ---
DB_NAME=newsrag
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=localhost  # On AWS: auto-filled from RDS endpoint
DB_PORT=5432

# --- QDRANT (Vector DB Cloud) ---
QDRANT_HOST=your-qdrant-host.qdrant.io
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=news_chunks

# --- KAFKA ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEWS=news_raw

# --- EMBEDDING (Lightweight: 33M params, 384d) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_SIZE=384
TOP_K=20

# --- LLM SETTINGS ---
NUM_MODEL_SUPPORT=3

# Model 1 (Groq - Qwen3 8B - Nhanh, tot cho Vietnamese)
MODEL_1_NAME=qwen3-8b-instant
MODEL_1_MODEL_ID=qwen/qwen3-8b-instant
MODEL_1_PROVIDER=groq
MODEL_1_API_KEY=your_groq_api_key
MODEL_1_TEMPERATURE=0.3
MODEL_1_MAX_TOKENS=2048

# Model 2 (Groq - Llama 3.1 8B - Fallback)
MODEL_2_NAME=llama-3.1-8b-instant
MODEL_2_MODEL_ID=meta-llama/llama-3.1-8b-instant
MODEL_2_PROVIDER=groq
MODEL_2_API_KEY=your_groq_api_key
MODEL_2_TEMPERATURE=0.3
MODEL_2_MAX_TOKENS=2048

# Model 3 (Google Gemini Flash - Fallback cuoi)
MODEL_3_NAME=gemini-2.0-flash
MODEL_3_MODEL_ID=gemini-2.0-flash
MODEL_3_PROVIDER=google
MODEL_3_API_KEY=your_google_api_key
MODEL_3_TEMPERATURE=0.3
MODEL_3_MAX_TOKENS=2048
