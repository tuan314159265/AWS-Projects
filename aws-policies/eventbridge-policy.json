{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECSRunTask",
      "Effect": "Allow",
      "Action": [
        "ecs:RunTask"
      ],
      "Resource": "arn:aws:ecs:ap-southeast-2:814808959551:task-definition/newsrag-*"
    },
    {
      "Sid": "PassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::814808959551:role/newsrag-ecs-execution-role",
        "arn:aws:iam::814808959551:role/newsrag-ecs-task-role"
      ]
    },
    {
      "Sid": "LambdaInvoke",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:ap-southeast-2:814808959551:function:newsrag-*"
    }
  ]
}
